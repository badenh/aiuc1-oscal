#!/bin/sh
# Public repo: badenh only. Reject Claude co-authors / session trailers.
msg_file="$1"
if grep -iE '^(Co-Authored-By:.*(claude|anthropic)|Claude-Session:)' "$msg_file" >/dev/null; then
